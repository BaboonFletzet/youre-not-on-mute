    "test:python": ".venv/bin/python -m pytest tests -q"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^36.9.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "@playwright/test": "^1.52.0"
  }
}
