{
  "name": "youre-not-on-mute",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
